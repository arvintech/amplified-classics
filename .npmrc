# M4 Apple Silicon Optimizations

# Use native ARM builds when available
force=false
legacy-peer-deps=false

# Optimize package installation
prefer-offline=true
audit=false
fund=false

# Cache settings for faster installs
cache-min=86400

# Use latest npm features
package-lock=true
save-exact=false

# Logging
loglevel=error
progress=true

# Performance
maxsockets=50
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

